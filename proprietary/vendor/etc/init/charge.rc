on charger-fs
    mkdir /mnt/vendor 0775 system system
    mount ext4 /dev/block/by-name/prodnv /mnt/vendor
    mount_all /vendor/etc/fstab.charge_mode --early
    chown system system /mnt/vendor
    chmod 0775 /mnt/vendor
    chmod 664 /sys/power/wakeup_count

on charger-apexd
    # Make sure that apexd is started in the default namespace
    enter_default_mount_ns

    start apexd

    # Wait for apexd to finish activating APEXes before starting more processes.
    wait_for_prop apexd.status activated
    perform_apex_config

on property:ro.debuggable=1
    start console

on charger
    trigger charger-apexd
    trigger charger-fs
    wait_for_prop vendor.all.modules.ready 1
    class_start thermal
    class_start charged_server

on property:drm.service.enabled=true
    setprop vendor.zteoffcharger.sync.drm true

on property:drm.service.enabled=1
    setprop vendor.zteoffcharger.sync.drm true

on property:ro.bootmode=charger && property:vendor.zteoffcharger.sync.drm=true
    class_start ztecharger

service vendor.charge /vendor/bin/charge
    group input system
    user root
    oneshot

service vendor.thermald.chg /vendor/bin/thermald
    class thermal
    user root
    group system

service vendor.charged.server /vendor/bin/charged
    class charged_server
    user root
    group system

service ztecharger /system/bin/ztecharger
    class ztecharger
    group root system
    user root
    seclabel u:r:ueventd:s0