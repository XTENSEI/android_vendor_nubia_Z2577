
# this init flow for touchscreen

on property:vendor.all.modules.ready=1
# proc/touchscreen
    chown system system /proc/touchscreen/wake_gesture
    chmod 644 /proc/touchscreen/wake_gesture
    chown system system /proc/touchscreen/smart_cover
    chmod 644 /proc/touchscreen/smart_cover
    chown system system proc/touchscreen/headset_state
    chmod 644 proc/touchscreen/headset_state
    chown system system proc/touchscreen/mRotation
    chown system system proc/touchscreen/single_tap
    chown system system proc/touchscreen/single_aod
    chmod 666 proc/touchscreen/single_aod
    chown system system proc/touchscreen/get_noise
    chown system system proc/touchscreen/edge_report_limit
    chmod 664 proc/touchscreen/edge_report_limit
    chown system system proc/touchscreen/one_key
    chmod 644 proc/touchscreen/one_key
    chown system system proc/touchscreen/play_game
    chmod 644 proc/touchscreen/play_game
    chown system system /sys/bus/platform/devices/zte_touch/uevent
    chown 0664 /sys/bus/platform/devices/zte_touch/uevent
    chown system system proc/touchscreen/sensibility
    chmod 644 proc/touchscreen/sensibility
    chown system system proc/touchscreen/tp_report_rate
    chmod 644 proc/touchscreen/tp_report_rate
    chown system system proc/touchscreen/rotation_limit_level
    chmod 644 proc/touchscreen/rotation_limit_level
    chown system system proc/touchscreen/pen_only
    chmod 646 proc/touchscreen/pen_only
    chown system system proc/touchscreen/tp_self_test
    chmod 646 proc/touchscreen/tp_self_test
    chown system system proc/touchscreen/tp_palm_mode
    chmod 646 proc/touchscreen/tp_palm_mode
    chown system system proc/touchscreen/BBAT_test
    chmod 646 proc/touchscreen/BBAT_test
    chown system system proc/touchscreen/tp_test
    chmod 646 proc/touchscreen/tp_test
    chown system system /proc/touchscreen/pen_low_batt_report_time
    chmod 664 /proc/touchscreen/pen_low_batt_report_time
    chown system system proc/touchscreen/tp_fake_aod_mode
    chmod 664 proc/touchscreen/tp_fake_aod_mode
    chown system system proc/touchscreen/fake_sleep
    chmod 664 proc/touchscreen/fake_sleep
    chown system system proc/touchscreen/screen_off_awake
    chmod 664 proc/touchscreen/screen_off_awake
    chown system system proc/touchscreen/tp_for_se_pad
    chmod 664 proc/touchscreen/tp_for_se_pad

# proc/touchscreen_2nd
    chown system system /proc/touchscreen_2nd/wake_gesture_2nd
    chmod 644 /proc/touchscreen_2nd/wake_gesture_2nd
    chown system system /proc/touchscreen_2nd/smart_cover_2nd
    chmod 644 /proc/touchscreen_2nd/smart_cover_2nd
    chown system system proc/touchscreen_2nd/headset_state_2nd
    chmod 644 proc/touchscreen_2nd/headset_state_2nd
    chown system system proc/touchscreen_2nd/mRotation_2nd
    chmod 666 proc/touchscreen_2nd/mRotation_2nd
    chown system system proc/touchscreen_2nd/single_tap_2nd
    chmod 666 proc/touchscreen_2nd/single_tap_2nd
    chown system system proc/touchscreen_2nd/single_aod_2nd
    chmod 666 proc/touchscreen_2nd/single_aod_2nd
    chown system system proc/touchscreen_2nd/get_noise_2nd
    chmod 664 proc/touchscreen_2nd/get_noise_2nd
    chown system system proc/touchscreen_2nd/edge_report_limit_2nd
    chmod 664 proc/touchscreen_2nd/edge_report_limit_2nd
    chown system system proc/touchscreen_2nd/one_key_2nd
    chmod 644 proc/touchscreen_2nd/one_key_2nd
    chown system system proc/touchscreen_2nd/play_game_2nd
    chmod 644 proc/touchscreen_2nd/play_game_2nd
    chown system system /sys/bus/platform/devices/zte_touch_2nd/uevent
    chown 664 /sys/bus/platform/devices/zte_touch_2nd/uevent
    chown system system proc/touchscreen_2nd/sensibility_2nd
    chmod 644 proc/touchscreen_2nd/sensibility_2nd
    chown system system proc/touchscreen_2nd/tp_report_rate_2nd
    chmod 644 proc/touchscreen_2nd/tp_report_rate_2nd
    chown system system proc/touchscreen_2nd/rotation_limit_level_2nd
    chmod 644 proc/touchscreen_2nd/rotation_limit_level_2nd
    chown system system proc/touchscreen_2nd/pen_only_2nd
    chmod 646 proc/touchscreen_2nd/pen_only_2nd
    chown system system proc/touchscreen_2nd/tp_self_test_2nd
    chmod 646 proc/touchscreen_2nd/tp_self_test_2nd
    chown system system proc/touchscreen_2nd/tp_palm_mode_2nd
    chmod 646 proc/touchscreen_2nd/tp_palm_mode_2nd
    chown system system proc/touchscreen_2nd/BBAT_test_2nd
    chmod 646 proc/touchscreen_2nd/BBAT_test_2nd
    chown system system proc/touchscreen_2nd/tp_test_2nd
    chmod 646 proc/touchscreen_2nd/tp_test_2nd
    chown system system proc/touchscreen_2nd/fake_sleep_2nd
    chmod 664 proc/touchscreen_2nd/fake_sleep_2nd
    chown system system proc/touchscreen_2nd/screen_off_awake_2nd
    chmod 664 proc/touchscreen_2nd/screen_off_awake_2nd

# add for touch self-test
    chmod 0646 /dev/gtp_tools

#add for sensorhub tp_ps sensor
    chown system system /sys/class/tp_ps/enable
    chown system system /sys/class/tp_ps/delay
    chown system system /sys/class/tp_ps/batch
    chown system system /sys/class/tp_ps/flush
    chmod 664 /sys/class/tp_ps/enable
    chmod 664 /sys/class/tp_ps/delay
    chmod 664 /sys/class/tp_ps/batch
    chmod 664 /sys/class/tp_ps/flush