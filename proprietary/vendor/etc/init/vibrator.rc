on early-boot
    chmod 0666 /dev/awinic_haptic
    chmod 0666 /dev/awinic_x_haptic
    chown system system /dev/aac_richtap_dev
    chown system system /dev/awinic_haptic
    chown system system /dev/awinic_x_haptic

on boot
    chown system system /sys/class/leds/haptic_vibrator/haptic_audio
    chown system system /sys/class/leds/haptic_vibrator/awrw
    chmod 0666 /sys/class/leds/haptic_vibrator/haptic_audio
    chmod 0777 /sys/class/leds/haptic_vibrator/awrw

service vendor.sprd.hardware.vibrator-service /vendor/bin/hw/vendor.sprd.hardware.vibrator-service
    setenv RICHTAP_DEVICE_PATH  /dev/awinic_haptic;/dev/awinic_x_haptic
    setenv ENV_RICHTAP_CONFIG_PATH /odm/etc/aac_richtap.config;/odm/etc/aac_richtap_1.config
    class hal
    user system
    group system input
