service vendor.fingerprint-default /vendor/bin/hw/vendor.zte.hardware.biometrics.fingerprint-service
    class late_start
    user system
    group system input uhid
    capabilities WAKE_ALARM
    disabled

on property:ro.vendor.zte.fingerprint.support=true
    start vendor.fingerprint-default
